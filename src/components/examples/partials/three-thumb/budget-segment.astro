---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="budget-segment" eyebrow="Three-plus thumb patterns" title="Budget allocator (segment drag)">
    <Fragment slot="description">
        The same three-thumb split with <code>interaction="range"</code>. Dragging one of the two interior bars shifts
        its share left or right without resizing it: the two thumbs bounding that bar move together, the categories on
        either side absorb the change, and the outer thumbs stay where they are. The first and last bars have only one
        thumb, so pressing there still moves that nearest thumb.
    </Fragment>
    <div slot="demo" style="position: relative">
        <style is:global>
            #budget-segment-range {
                --track-height: 50px;
                --thumb-size: 36px;
            }
            #budget-segment-range::part(slider-track) {
                border-radius: 25px;
                overflow: hidden;
            }
            #budget-segment-range::part(slider-thumb) {
                border: 4px solid #ffffff;
                background-color: white;
                background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='none' stroke='%230b1220' stroke-linecap='round' stroke-linejoin='bevel' stroke-width='1.5' d='M15.3 16.78l4.11-4.11a1 1 0 000-1.41l-4-4M8.7 7.22L4.59 11.33a1 1 0 000 1.41l4 4'/%3E%3C/svg%3E");
                background-position: center;
                background-repeat: no-repeat;
                background-size: 60%;
                box-shadow:
                    0 4px 6px -1px rgba(0, 0, 0, 0.3),
                    0 2px 4px -1px rgba(0, 0, 0, 0.1);
            }

            #budget-segment-range::part(slider-segment) {
                anchor-name: var(--anchor-name);
            }
            #budget-segment-range::part(slider-segment-1) {
                background-color: #e53935;
                --anchor-name: --budget-drag-segment-1;
            }
            #budget-segment-range::part(slider-segment-2) {
                background-color: #8e24aa;
                --anchor-name: --budget-drag-segment-2;
            }
            #budget-segment-range::part(slider-segment-3) {
                background-color: #f57c00;
                --anchor-name: --budget-drag-segment-3;
            }
            #budget-segment-range::part(slider-segment-4) {
                background-color: #3949ab;
                --anchor-name: --budget-drag-segment-4;
            }

            .budget-segment-label {
                position: fixed;
                color: white;
                position-anchor: var(--anchor);
                top: anchor(var(--anchor) top);
                left: anchor(var(--anchor) center);
                /* `left` puts the box's edge on the segment centre; pull it back half its own
                   width so the text straddles the centre instead. */
                transform: translateX(-50%);
                translate: 0 25%;
                text-align: center;
                font-size: 0.875rem;
                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
                line-height: 1.2;
                pointer-events: none;
            }
            #budget-segment-label-0 {
                --anchor: --budget-drag-segment-1;
            }
            #budget-segment-label-1 {
                --anchor: --budget-drag-segment-2;
            }
            #budget-segment-label-2 {
                --anchor: --budget-drag-segment-3;
            }
            #budget-segment-label-3 {
                --anchor: --budget-drag-segment-4;
            }

            .budget-segment-label strong {
                font-size: 1rem;
                font-weight: 700;
            }

            @media (max-width: 700px) {
                #budget-segment-range {
                    --track-height: 44px;
                    --thumb-size: 32px;
                }
                #budget-segment-range::part(slider-track) {
                    border-radius: 22px;
                }
                .budget-segment-label {
                    font-size: 0.76rem;
                    line-height: 1.1;
                    translate: 0 30%;
                }
                .budget-segment-label strong {
                    font-size: 0.86rem;
                }
            }

            @media (max-width: 420px) {
                .budget-segment-label {
                    font-size: 0.66rem;
                    line-height: 1;
                    translate: 0 36%;
                }
                .budget-segment-label strong {
                    display: none;
                }
            }
        </style>
        <div class="budget-range-wrapper">
            <range-group id="budget-segment-range" min="0" max="100" interaction="range">
                <legend slot="legend" class="visually-hidden">Budget allocator with draggable shares</legend>
                <label class="visually-hidden">
                    Groceries/Rent separator
                    <input type="range" value="25" />
                </label>
                <label class="visually-hidden">
                    Rent/Transport separator
                    <input type="range" value="50" />
                </label>
                <label class="visually-hidden">
                    Transport/Internet separator
                    <input type="range" value="75" />
                </label>
            </range-group>
            <div id="budget-segment-labels" class="budget-labels">
                <div id="budget-segment-label-0" class="budget-segment-label"></div>
                <div id="budget-segment-label-1" class="budget-segment-label"></div>
                <div id="budget-segment-label-2" class="budget-segment-label"></div>
                <div id="budget-segment-label-3" class="budget-segment-label"></div>
            </div>
        </div>
        <div id="budget-segment-announcer" aria-live="polite" role="status" class="visually-hidden"></div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<!-- interaction is a working name: https://github.com/openui/open-ui/issues/1460 -->
<rangegroup id="budget-range" min="0" max="100" interaction="range">
  <legend>Budget allocator with draggable shares</legend>
  <label>Groceries / Rent     <input type="range" value="25"></label>
  <label>Rent / Transport     <input type="range" value="50"></label>
  <label>Transport / Internet <input type="range" value="75"></label>
</rangegroup>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
/* the two interior bars are the draggable ones: each is bounded by two thumbs */
rangegroup::slider-segment(2) { background-color: #8e24aa; }
rangegroup::slider-segment(3) { background-color: #f57c00; }
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
/* Rent and Transport keep their share while dragged; Groceries and Internet
   absorb the movement. The drag stops at the neighbouring thumb. */
const rg = document.querySelector("#budget-range");

rg.addEventListener("input", () => {
  const stops = [0, ...rg.values, 100];
  console.log(stops[2] - stops[1]); // constant while dragging bar 2
});
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const rg = document.querySelector("#budget-segment-range");
                const announcer = document.querySelector("#budget-segment-announcer");
                const labels = document.querySelectorAll(".budget-segment-label");
                const categories = ["Groceries", "Rent", "Transport", "Internet"];
                if (!rg) return;

                const update = () => {
                    const stops = [0, ...rg.values, 100];
                    let announcement = "Budget updated. ";
                    labels.forEach((label, i) => {
                        const pct = Math.round(stops[i + 1] - stops[i]);
                        label.replaceChildren();
                        const categoryName = document.createElement("strong");
                        categoryName.textContent = categories[i];
                        label.append(
                            categoryName,
                            document.createElement("br"),
                            document.createTextNode(`${pct}%`),
                        );
                        announcement += categories[i] + ": " + pct + "%. ";
                    });
                    announcer.textContent = announcement.trim();
                };

                rg.addEventListener("input", update);
                update();
            };

            const run = () => {
                if (typeof customElements?.whenDefined === "function") {
                    customElements
                        .whenDefined("range-group")
                        .then(init)
                        .catch(() => init());
                    return;
                }
                init();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", run, { once: true });
            } else {
                run();
            }
        })();
    </script>
</ExampleSection>
